<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vw_kok"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/vakit_widget_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingLeft="14dp"
    android:paddingTop="8dp"
    android:paddingRight="14dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☾ Nur Vakti"
            android:textColor="#C9A45C"
            android:textSize="12sp"
            android:fontFamily="serif" />
        <TextView
            android:id="@+id/vw_yer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="#9AA1BD"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/vw_baslik"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="serif"
        android:text="Sıradaki vakit"
        android:textColor="#C9A45C"
        android:textSize="15sp" />

    <Chronometer
        android:id="@+id/vw_sayac"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:textColor="#EDE4CF"
        android:textSize="34sp" />

    <TextView
        android:id="@+id/vw_alt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#9AA1BD"
        android:textSize="12sp" />
</LinearLayout>
