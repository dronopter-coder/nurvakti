<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vw_kok"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/vakit_widget_bg"
    android:padding="6dp">

    <!-- Ana ekrandaki gibi dönen yıldız ve dolan halka -->
    <ImageView
        android:id="@+id/vw_halka"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:fontFamily="serif"
        android:text="☾ Nur Vakti"
        android:textColor="#C9A45C"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/vw_yer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#9AA1BD"
        android:textSize="10sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/vw_baslik"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="Sıradaki vakit"
            android:textColor="#C9A45C"
            android:textSize="13sp" />

        <Chronometer
            android:id="@+id/vw_sayac"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:textColor="#EDE4CF"
            android:textSize="27sp" />

        <TextView
            android:id="@+id/vw_alt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#9AA1BD"
            android:textSize="10.5sp" />
    </LinearLayout>
</FrameLayout>
